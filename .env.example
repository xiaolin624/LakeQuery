# LakeQuery 环境变量配置
# 复制为 .env 并填入实际值：cp .env.example .env

# ── LLM（必填）──────────────────────
LQ_LLM_API_KEY=your-api-key-here
LQ_LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LQ_LLM_MODEL=your-endpoint-id

# ── Qdrant（Schema RAG 需要）────────
LQ_QDRANT_URL=http://localhost:6333
LQ_QDRANT_COLLECTION=table_schemas
# LQ_QDRANT_API_KEY=

# ── Embedding ────────────────────────
# LQ_EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5

# ── Server ───────────────────────────
# LQ_HOST=0.0.0.0
# LQ_PORT=8000
